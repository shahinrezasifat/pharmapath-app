<?xml version="1.0" encoding="utf-8"?>
<!--
  PharmaPath talks to a *self-hosted* BD Medicine API. During local
  development that server is plain HTTP on the developer machine, which
  modern Android blocks by default. Cleartext is therefore allowed only for
  loopback and the emulator host alias — never for arbitrary internet hosts.

  Physical device + local server: run
      adb reverse tcp:8000 tcp:8000
  and set the API base to http://127.0.0.1:8000. For a server on the LAN or
  the public internet, use HTTPS (or a TLS-terminating proxy).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
